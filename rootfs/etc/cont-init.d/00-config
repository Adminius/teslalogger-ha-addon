#!/bin/bash
set -euo pipefail

mkdir -p /run/s6/container_environment
read_option() {
  jq -r --arg key "$1" --arg default "$2" '.[$key] // $default' /data/options.json
}
write_env() {
  local key="$1" value="$2"
  printf '%s' "$value" > "/run/s6/container_environment/$key"
}

write_env TZ "$(read_option TZ Europe/Berlin)"
write_env DBConnectionstring "$(read_option DBConnectionstring 'Server=core-mariadb;Port=3306;Database=teslalogger;Uid=teslalogger;Password=teslalogger;CharSet=utf8mb4;')"

# Keep TeslaLogger data and generated exports across add-on upgrades/rebuilds.
mkdir -p /config/data /config/backup /config/invoices
mkdir -p /etc/teslalogger/data /etc/teslalogger/backup /etc/teslalogger/Debug/net8.0/tesla_invoices
for pair in \
  "/etc/teslalogger/data:/config/data" \
  "/etc/teslalogger/backup:/config/backup" \
  "/etc/teslalogger/Debug/net8.0/tesla_invoices:/config/invoices"; do
  IFS=: read -r source_path target_path <<< "$pair"
  if [ ! -L "$source_path" ]; then
    if [ -d "$source_path" ]; then cp -a "$source_path/." "$target_path/"; rm -rf "$source_path"; fi
    ln -s "$target_path" "$source_path"
  fi
done

# Both add-ons map Home Assistant's /share folder, like the original Docker volumes.
grafana_share=/share/teslalogger/grafana
mkdir -p "$grafana_share/dashboards" "$grafana_share/plugins" "$grafana_share/provisioning/dashboards"
link_shared_directory() {
  local source_path="$1" target_path="$2"
  mkdir -p "$target_path"
  if [ -L "$source_path" ] && [ "$(readlink "$source_path")" = "$target_path" ]; then
    return
  fi
  if [ -L "$source_path" ]; then
    rm -f "$source_path"
  elif [ -d "$source_path" ]; then
    cp -a "$source_path/." "$target_path/"
    rm -rf "$source_path"
  elif [ -e "$source_path" ]; then
    rm -f "$source_path"
  fi
  mkdir -p "$(dirname "$source_path")"
  ln -s "$target_path" "$source_path"
}
link_shared_directory /var/lib/grafana/dashboards "$grafana_share/dashboards"
link_shared_directory /var/lib/grafana/plugins "$grafana_share/plugins"
mkdir -p /etc/grafana/provisioning
link_shared_directory /etc/grafana/provisioning/dashboards "$grafana_share/provisioning/dashboards"

# The upstream PHP UI expects the compose service name for the API. Both services
# run in this add-on container, so route that hostname to the local API instead.
find /var/www/html -type f \( -name '*.php' -o -name '*.js' \) -exec sed -i 's#http://teslalogger:#http://127.0.0.1:#g' {} +

